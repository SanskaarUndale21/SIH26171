{
  "_comment": "Single source of truth for text PII patterns. Loaded by extension/src/perception/regex.ts (OCR text on screen) and Jarvis/src/redact.js (chat + tool output). Order matters: card before aadhaar/phone so a 16-digit card isn't half-matched by a shorter rule. 'group' redacts only that capture group (the value after a keyword). 'check' drops matches that fail a checksum: luhn (cards) or verhoeff (Aadhaar), which keeps random 12-16 digit reference numbers from being masked.",
  "rules": [
    {
      "type": "secret",
      "token": "SECRET",
      "pattern": "\\b(password|passwd|pwd|pin|otp|cvv|api[_-]?key|token|secret)(\\s*[:=]\\s*|\\s+is\\s+)(\\S+)",
      "flags": "gi",
      "group": 3
    },
    {
      "type": "email",
      "token": "EMAIL",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "flags": "g"
    },
    {
      "type": "card_number",
      "token": "CARD",
      "pattern": "\\b\\d(?:[ -]?\\d){12,18}\\b",
      "flags": "g",
      "check": "luhn"
    },
    {
      "type": "aadhaar",
      "token": "AADHAAR",
      "pattern": "(?<![\\d][ -]?)\\b[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}\\b(?![ -]?\\d)",
      "flags": "g",
      "check": "verhoeff"
    },
    {
      "type": "pan",
      "token": "PAN",
      "pattern": "\\b[A-Z]{5}\\d{4}[A-Z]\\b",
      "flags": "g"
    },
    {
      "type": "phone_number",
      "token": "PHONE",
      "pattern": "(?<![\\d][ -]?)(?:\\+\\d{1,3}[ -]?)?(?:\\b[6-9]\\d{4}[ -]?\\d{5}\\b|\\(?\\b\\d{3}\\)?[ -]\\d{3}[ -]\\d{4}\\b)(?![ -]?\\d)",
      "flags": "g"
    },
    {
      "type": "ip_address",
      "token": "IP",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b",
      "flags": "g"
    }
  ]
}

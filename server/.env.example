# The browser planner and Jarvis both go through this server. They can use different
# providers: PLANNER_* for the planner, JARVIS_* for Jarvis (falls back to PLANNER_*).
# Any OpenAI-compatible endpoint works: Groq, OpenRouter, Together, or a local
# Ollama / vLLM / llama.cpp server.

# Planner: needs a VISION model (reads the sanitized screenshot).
# Open-weights and free, on your own GPU (6 GB is enough for gemma3:4b):
#   ollama pull gemma3:4b
PLANNER_BASE_URL=http://localhost:11434/v1
PLANNER_MODEL=gemma3:4b
PLANNER_API_KEY=

# Jarvis: text + tool calling. Groq's free tier, open-weights gpt-oss-120b.
JARVIS_BASE_URL=https://api.groq.com/openai/v1
JARVIS_API_KEY=
JARVIS_MODEL=openai/gpt-oss-120b

# One config for the whole project: the browser extension's planner AND the Jarvis desktop
# app both go through this server. Defaults are open-weights models on Groq.
#
# Any OpenAI-compatible endpoint works: Groq, OpenRouter, Together, or a self-hosted
# vLLM / Ollama / llama.cpp server (e.g. PLANNER_BASE_URL=http://localhost:11434/v1).
PLANNER_API_KEY=
PLANNER_BASE_URL=https://api.groq.com/openai/v1
# Vision model: reads the sanitized (already redacted) screenshot.
PLANNER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Text + tool-calling model for Jarvis. Leave empty to reuse PLANNER_MODEL.
JARVIS_MODEL=llama-3.3-70b-versatile

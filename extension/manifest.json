{
  "manifest_version": 3,
  "name": "Fusion Privacy Agent",
  "version": "0.1.0",
  "description": "On-device visual perception, live redaction overlay, and eval-backed PII protection for a lightweight browser agent (SIH 26171)",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "offscreen", "sidePanel"],
  "host_permissions": [
    "http://localhost:8100/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+A", "mac": "Command+Shift+A" },
      "description": "Open the Fusion Privacy Agent side panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
